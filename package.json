{
  "name": "kingdom-rebellion",
  "version": "1.0.0",
  "private": true,
  "description": "왕국과 반란 — 비공개 카드 전략 멀티플레이",
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "build:vercel": "node deploy/build-vercel.js",
    "online": "node deploy/online.js start",
    "online:status": "node deploy/online.js status",
    "online:stop": "node deploy/online.js stop",
    "test": "node --test",
    "ai:train": "node ai/train-complete.js",
    "ai:evaluate": "node ai/evaluate-complete.js",
    "ai:verify": "node ai/verify-complete.js",
    "ai:sweep": "node ai/sweep-construction.js"
  },
  "engines": { "node": ">=20" },
  "dependencies": {
    "express": "^4.21.2",
    "socket.io": "^4.8.1"
  },
  "devDependencies": {
    "socket.io-client": "^4.8.1"
  }
}
